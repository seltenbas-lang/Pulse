/// A 24x24 icon: a stroked path and/or a filled path, both in `tint`.
// the default icon colour (on-surface-variant), set from Rust with the theme
export global IconTint {
    in-out property <color> c: #CFCFCF;
}

export component Icon inherits Rectangle {
    in property <string> stroke-path;
    in property <string> fill-path;
    in property <color> tint: IconTint.c;
    in property <length> stroke-w: 2px;
    width: 20px;
    height: 20px;
    if root.fill-path != "": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.fill-path;
        fill: root.tint;
    }
    if root.stroke-path != "": Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.stroke-path;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.stroke-w * root.width / 24px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
